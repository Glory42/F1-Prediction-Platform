---
import type { getCircuitMetadata } from '../circuitMetadata';

interface Props {
  meta: ReturnType<typeof getCircuitMetadata>;
}

const { meta } = Astro.props;
---

<div class="border border-white/[0.06] bg-black p-5">
  <h2 class="font-mono text-[10px] tracking-[0.25em] uppercase text-muted-foreground mb-4">Telemetry & Bias</h2>
  <div class="space-y-4">
    <div class="flex items-center justify-between py-1.5 border-b border-white/[0.04]">
      <span class="font-mono text-[9px] tracking-wider text-muted-foreground uppercase">Longest Straight</span>
      <span class="font-mono text-xs font-semibold text-white">{meta.longestStraightM} m</span>
    </div>

    <div>
      <span class="block font-mono text-[9px] tracking-wider text-muted-foreground uppercase mb-2">Corner Distribution</span>
      <div class="grid grid-cols-3 gap-2">
        {[
          { label: 'Low Speed', val: meta.lowSpeedCorners },
          { label: 'Medium', val: meta.medSpeedCorners },
          { label: 'High Speed', val: meta.highSpeedCorners },
        ].map((c) => (
          <div class="bg-white/[0.01] border border-white/[0.04] p-2 text-center">
            <span class="block font-mono text-[8px] text-muted-foreground/60 uppercase">{c.label}</span>
            <span class="font-mono text-xs font-semibold text-white">{c.val}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-2">
      <span class="block font-mono text-[9px] tracking-wider text-muted-foreground uppercase">Track Bias</span>
      <div class="space-y-1.5">
        {[
          { label: 'Straight-Line Power', val: meta.powerWeight },
          { label: 'Aerodynamic Downforce', val: meta.downforceWeight },
        ].map((b) => (
          <div>
            <div class="flex justify-between font-mono text-[8px] text-muted-foreground/80 mb-0.5">
              <span>{b.label}</span>
              <span>{b.val}%</span>
            </div>
            <div class="h-1.5 w-full bg-white/[0.04] rounded-full overflow-hidden">
              <div class="h-full bg-purple-500 bar-fill" style={`width: ${b.val}%`} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
