---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { RaceResultsTable } from '@/features/races/components/RaceResultsTable';
import { QualifyingGrid } from '@/features/races/components/QualifyingGrid';
import LapChart from '@/features/races/components/LapChart.astro';
import RaceHeroInfo from '@/features/races/components/RaceHeroInfo.astro';
import RacePredictionPanel from '@/features/races/components/RacePredictionPanel.astro';
import { api } from '@/lib/api';
import { formatDate, formatMs } from '@/lib/utils';
import type { PredictionResponse, CircuitHistoryItem } from '@/types';
import { RotateCcw, Gauge, Zap, Flag, CornerDownRight, Wind } from 'lucide-react';
import type { LucideIcon } from 'lucide-react';
import { GP_ACCENT } from '@/features/predictions/types';

const { id } = Astro.params;

let raceData = null;
let prediction: PredictionResponse | null = null;
let circuitHistory: CircuitHistoryItem[] = [];
let error = null;

try {
  raceData = await api.getRaceById(Number(id));
} catch (e) {
  error = e instanceof Error ? e.message : 'Failed to load race';
}

const race = raceData?.race;

if (race) {
  const [predResult, histResult] = await Promise.allSettled([
    api.getPredictionByRace(race.id),
    api.getCircuitDetails(race.circuit.circuitKey),
  ]);
  if (predResult.status === 'fulfilled') prediction = predResult.value;
  if (histResult.status === 'fulfilled') circuitHistory = histResult.value.history;
}

const isCompleted = race?.status === 'completed';
const isQualiDone = race?.status === 'qualifying_done';
const isSprintish = race?.status === 'sprint_done' || race?.status === 'sprint_qualifying_done';

const hasResults = (raceData?.results?.length ?? 0) > 0;
const hasQualifying = (raceData?.qualifying?.length ?? 0) > 0;
const hasLaps = (raceData?.laps?.length ?? 0) > 0;

type Tab = { id: string; label: string };
const tabs: Tab[] = [];
if (isCompleted && hasResults) tabs.push({ id: 'results', label: 'Results' });
if (hasQualifying) tabs.push({ id: 'qualifying', label: 'Qualifying' });
if (isCompleted && hasLaps) tabs.push({ id: 'laps', label: 'Lap Chart' });
tabs.push({ id: 'circuit', label: 'Circuit' });

const circuitYearItems = [...circuitHistory]
  .sort((a, b) => b.year - a.year)
  .map((h) => ({ year: h.year, href: `/races/${h.raceId}` }));

const defaultTab = tabs[0]?.id ?? 'circuit';
const raceYear = race ? new Date(race.raceDate).getFullYear() : new Date().getFullYear();

const podium = (prediction?.drivers ?? [])
  .sort((a, b) => (a.predictedPosition ?? 99) - (b.predictedPosition ?? 99))
  .slice(0, 5);

const actualWinner = hasResults ? raceData!.results.find((r) => r.finishPosition === 1) : null;
const flResult = hasResults ? raceData!.results.find((r) => r.fastestLap) : null;
const flLapMs = flResult && raceData?.laps
  ? raceData.laps.find((l) => l.driverId === flResult.driver.id)?.fastestLapMs ?? null
  : null;
const predCorrect = prediction && actualWinner
  ? prediction.predictedWinner.id === actualWinner.driver.id
  : null;

const raceDistanceKm = race
  ? (race.circuit.lapCount * Number(race.circuit.trackLengthKm)).toFixed(1)
  : null;

const conditions: { label: string; val: string | number }[] = [];
if (race) {
  if (race.safetyCarLaps != null) conditions.push({ label: 'SC Laps', val: race.safetyCarLaps });
  if (race.vscLaps != null) conditions.push({ label: 'VSC', val: race.vscLaps });
  if (race.airTempAvg) conditions.push({ label: 'Air', val: `${Math.round(Number(race.airTempAvg))}°C` });
  if (race.trackTempAvg) conditions.push({ label: 'Track', val: `${Math.round(Number(race.trackTempAvg))}°C` });
  if (race.humidityAvg) conditions.push({ label: 'Humidity', val: `${Math.round(Number(race.humidityAvg))}%` });
}

const statusToneClass = isCompleted
  ? 'border-[rgba(168,85,247,0.3)] text-[rgba(168,85,247,0.7)]'
  : isQualiDone
  ? 'border-yellow-500/30 text-yellow-400/70'
  : isSprintish
  ? 'border-orange-500/30 text-orange-400/70'
  : 'border-white/[0.08] text-muted-foreground';

const circuitStats: Array<{ Icon: LucideIcon; label: string; val: string | number }> = race ? [
  { Icon: RotateCcw, label: 'Laps', val: race.circuit.lapCount },
  { Icon: Gauge, label: 'Length', val: `${race.circuit.trackLengthKm} km` },
  { Icon: Flag, label: 'Race Dist', val: `${raceDistanceKm} km` },
  { Icon: CornerDownRight, label: 'Corners', val: race.circuit.numberOfCorners ?? '—' },
  { Icon: Wind, label: 'DRS Zones', val: race.circuit.drsZones ?? '—' },
  { Icon: Zap, label: 'Overtake Rate', val: race.circuit.overtakeRate ? `${Math.round(Number(race.circuit.overtakeRate) * 100)}%` : '—' },
] : [];
---

<BaseLayout title={race?.name ?? 'Race'}>
  <div class="mt-7 space-y-8">

    <a href="/races" class="inline-block font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">
      ← all races
    </a>

    {error ? (
      <div class="border border-destructive/40 bg-destructive/10 p-8 text-center">
        <p class="font-mono text-[10px] text-destructive tracking-widest uppercase">Race not found</p>
      </div>
    ) : raceData && race ? (
      <>
        {/* ── HERO ── */}
        <div class="panel">
          <div class="grid lg:grid-cols-[1fr_320px]">
            <RaceHeroInfo
              kicker={`./round-${race.roundNumber.toString().padStart(2, '0')}`}
              statusIcon={isCompleted ? 'check' : (isQualiDone || isSprintish) ? 'zap' : 'timer'}
              statusLabel={race.status.replace(/_/g, ' ')}
              statusToneClass={statusToneClass}
              raceName={race.name}
              circuit={race.circuit}
              dateStr={formatDate(race.raceDate)}
              lapsLabel={`${race.circuit.lapCount} laps`}
              lengthKm={race.circuit.trackLengthKm}
              weather={race.weather}
              conditions={conditions}
              fastestLap={flResult ? { code: flResult.driver.code, timeStr: flLapMs ? formatMs(flLapMs) : null } : null}
              accent={GP_ACCENT}
              countdown={!isCompleted ? { id: 'race-countdown', date: race.raceDateUtc || race.raceDate, borderClass: 'border-white/[0.08]', digitClass: 'countdown-d' } : null}
              yearItems={circuitYearItems}
              currentYear={raceYear}
            />

            <RacePredictionPanel
              accent={GP_ACCENT}
              heading="./prediction"
              fullHref={`/prediction/${race.id}`}
              hasPrediction={!!prediction}
              predictedWinnerName={prediction?.predictedWinner.fullName}
              winnerLabel="predicted winner"
              confidence={Math.round(Number(podium[0]?.winProbability ?? 0) * 100)}
              podium={podium}
              showAccuracy={isCompleted}
              predCorrect={predCorrect}
              actualWinnerName={isCompleted && actualWinner && actualWinner.driver.id !== prediction?.predictedWinner.id ? actualWinner.driver.fullName : null}
              actualLabel="actual winner"
              emptyText={isCompleted ? 'No prediction data' : 'Available after qualifying'}
            />
          </div>
        </div>

        {/* ── TABS ── */}
        {tabs.length > 0 && (
          <div>
            <div class="flex items-center gap-1.5 mb-6" role="tablist">
              {tabs.map((t) => (
                <button
                  type="button"
                  data-tab={t.id}
                  id={`tab-${t.id}`}
                  role="tab"
                  aria-selected={t.id === defaultTab ? 'true' : 'false'}
                  aria-controls={`panel-${t.id}`}
                  tabindex={t.id === defaultTab ? 0 : -1}
                  class={`tab-btn font-mono text-[9px] tracking-[0.12em] uppercase px-3 py-1.5 border transition-colors duration-150 ${
                    t.id === defaultTab
                      ? 'border-[rgba(168,85,247,0.5)] text-[#a855f7] bg-[rgba(168,85,247,0.08)]'
                      : 'border-white/[0.08] text-muted-foreground hover:text-foreground hover:border-white/[0.15]'
                  }`}
                >
                  {t.label}
                </button>
              ))}
            </div>

            {hasResults && (
              <div id="panel-results" role="tabpanel" aria-labelledby="tab-results" class={`tab-panel ${defaultTab !== 'results' ? 'hidden' : ''}`}>
                <div class="border border-white/[0.06] overflow-hidden">
                  <RaceResultsTable results={raceData.results} year={raceYear} laps={raceData.laps} />
                </div>
              </div>
            )}

            {hasQualifying && (
              <div id="panel-qualifying" role="tabpanel" aria-labelledby="tab-qualifying" class={`tab-panel ${defaultTab !== 'qualifying' ? 'hidden' : ''}`}>
                <div class="border border-white/[0.06] overflow-hidden">
                  <QualifyingGrid qualifying={raceData.qualifying} year={raceYear} />
                </div>
              </div>
            )}

            {hasLaps && (
              <div id="panel-laps" role="tabpanel" aria-labelledby="tab-laps" class={`tab-panel ${defaultTab !== 'laps' ? 'hidden' : ''}`}>
                <div class="border border-white/[0.06] overflow-hidden">
                  <LapChart laps={raceData.laps} />
                </div>
              </div>
            )}

            <div id="panel-circuit" role="tabpanel" aria-labelledby="tab-circuit" class={`tab-panel ${defaultTab !== 'circuit' ? 'hidden' : ''}`}>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-white/[0.06]">
                {circuitStats.map(({ Icon, label, val }) => (
                  <div class="bg-black p-5">
                    <div class="flex items-center gap-1 font-mono text-[8px] text-muted-foreground tracking-widest uppercase mb-2">
                      <Icon size={10} />{label}
                    </div>
                    <div class="font-bold text-xl">{val}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </>
    ) : null}
  </div>
</BaseLayout>

<script>
  import { initRaceCountdown, initRaceTabs } from '@/features/races/raceTabs';

  document.addEventListener('astro:page-load', () => {
    initRaceCountdown('race-countdown', 'raceDate', 'countdown-d');
    initRaceTabs({
      btnClass: 'tab-btn',
      panelClass: 'tab-panel',
      panelIdPrefix: 'panel-',
      activeBorder: 'rgba(168,85,247,0.5)',
      activeColor: '#a855f7',
      activeBg: 'rgba(168,85,247,0.08)',
      strippedClasses: ['border-[rgba(168,85,247,0.5)]', 'text-[#a855f7]', 'bg-[rgba(168,85,247,0.08)]'],
    });
  });
</script>
