---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api } from '@/lib/api';
import type { SeasonAccuracy } from '@/types';
import { Cpu, ChevronRight } from 'lucide-react';

let seasonAccuracy: SeasonAccuracy[] = [];
try {
  seasonAccuracy = await api.getPredictionAccuracy();
} catch {
  seasonAccuracy = [];
}

const seasons = [...seasonAccuracy].sort((a, b) => b.year - a.year);
const totalRaces = seasons.reduce((sum, s) => sum + s.overall.races, 0);
const totalCorrect = seasons.reduce((sum, s) => sum + s.overall.correct, 0);
const allTimePct = totalRaces > 0 ? Math.round((totalCorrect / totalRaces) * 100) : null;
---

<BaseLayout title="Prediction Recaps">
  <div class="mt-7 space-y-10">

    <div class="mb-2 flex items-center gap-4">
      <a href="/prediction" class="font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">
        ← prediction hub
      </a>
    </div>

    <div>
      <div class="flex items-center gap-3 mb-2">
        <span class="flex items-center gap-1.5 font-mono text-[9px] tracking-[0.25em] uppercase" style="color: rgba(168,85,247,0.55)"><Cpu size={11} />./recap</span>
        <div class="h-px w-16 bg-white/[0.05]" />
      </div>
      <h1 class="text-2xl font-bold">Prediction Recaps</h1>
      <p class="mt-1 font-mono text-[10px] text-muted-foreground tracking-widest uppercase">
        {seasons.length} {seasons.length === 1 ? 'season' : 'seasons'}
        {allTimePct !== null && <> · {totalCorrect}/{totalRaces} winners called ({allTimePct}%)</>}
      </p>
    </div>

    {seasons.length === 0 ? (
      <div class="border border-white/[0.06] p-10 text-center">
        <p class="font-mono text-[9px] text-muted-foreground tracking-[0.25em] uppercase">No recap data yet</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {seasons.map((s) => (
          <a href={`/prediction/recap/${s.year}`} class="panel p-5 group hover:border-[rgba(168,85,247,0.35)] transition-colors duration-150">
            <div class="flex items-start justify-between">
              <div class="text-3xl font-bold group-hover:text-[#a855f7] transition-colors duration-150">{s.year}</div>
              <ChevronRight size={16} className="text-muted-foreground/40 group-hover:text-[#a855f7] transition-colors duration-150" />
            </div>
            <div class="mt-3 flex items-baseline gap-2">
              <span class="text-2xl font-bold text-[#a855f7]">{s.overall.accuracyPct ?? '—'}{s.overall.accuracyPct !== null && '%'}</span>
              <span class="font-mono text-[9px] text-muted-foreground">overall · {s.overall.correct}/{s.overall.races}</span>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2">
              <div class="border border-white/[0.06] px-3 py-2">
                <div class="font-mono text-[8px] text-muted-foreground tracking-widest uppercase">GP</div>
                <div class="font-mono text-[10px] font-bold mt-0.5">
                  {s.gp.races > 0 ? <>{s.gp.correct}/{s.gp.races} <span class="text-muted-foreground font-normal">({s.gp.accuracyPct}%)</span></> : <span class="text-muted-foreground font-normal">—</span>}
                </div>
              </div>
              <div class="border border-white/[0.06] px-3 py-2">
                <div class="font-mono text-[8px] text-muted-foreground tracking-widest uppercase">Sprint</div>
                <div class="font-mono text-[10px] font-bold mt-0.5">
                  {s.sprint.races > 0 ? <>{s.sprint.correct}/{s.sprint.races} <span class="text-muted-foreground font-normal">({s.sprint.accuracyPct}%)</span></> : <span class="text-muted-foreground font-normal">—</span>}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

  </div>
</BaseLayout>
