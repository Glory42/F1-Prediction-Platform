---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api } from '@/lib/api';
import type { PredictionHistoryItem, SeasonSummary } from '@/types';
import { Cpu, Award, Flame, TrendingDown } from 'lucide-react';
import YearSelectLinks from '@/components/shared/YearSelectLinks.astro';
import { brierScore, bestCall, worstMiss, longestStreak } from '@/lib/predictionMath';

const year = Number(Astro.params.year);

let history: PredictionHistoryItem[] = [];
let seasons: SeasonSummary[] = [];

const [historyResult, seasonsResult] = await Promise.allSettled([
  api.getPredictionHistory(year),
  api.getSeasons(),
]);

if (historyResult.status === 'fulfilled') history = historyResult.value;
if (seasonsResult.status === 'fulfilled') seasons = seasonsResult.value;

const yearLinks = seasons
  .filter((s) => s.raceCount > 0)
  .map((s) => ({ year: s.year, href: `/prediction/recap/${s.year}` }));

const ordered = [...history].sort((a, b) => a.roundNumber - b.roundNumber);
const completed = ordered.filter((h) => h.correct !== null);
const correctCount = completed.filter((h) => h.correct === true).length;
const top3 = completed.filter((h) => h.actualWinnerPredictedPosition !== null && h.actualWinnerPredictedPosition <= 3).length;
const top5 = completed.filter((h) => h.actualWinnerPredictedPosition !== null && h.actualWinnerPredictedPosition <= 5).length;

const pct = (n: number) => (completed.length > 0 ? Math.round((n / completed.length) * 100) : null);
const p1Accuracy = pct(correctCount);
const top3Accuracy = pct(top3);
const top5Accuracy = pct(top5);
const brier = brierScore(ordered);
const streak = longestStreak(ordered);
const best = bestCall(ordered);
const worst = worstMiss(ordered);

const hrefFor = (h: PredictionHistoryItem) => (h.isSprint ? `/prediction/sprint/${h.raceId}` : `/prediction/${h.raceId}`);
---

<BaseLayout title={`${year} Prediction Recap`}>
  <div class="mt-7 space-y-10">

    <div class="mb-2 flex items-center gap-4">
      <a href="/prediction/recap" class="font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">
        ← all recaps
      </a>
      <a href={`/prediction?year=${year}`} class="font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">
        {year} predictions →
      </a>
    </div>

    <div class="flex items-end justify-between gap-4 flex-wrap">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <span class="flex items-center gap-1.5 font-mono text-[9px] tracking-[0.25em] uppercase" style="color: rgba(168,85,247,0.55)"><Cpu size={11} />./recap</span>
          <div class="h-px w-16 bg-white/[0.05]" />
        </div>
        <h1 class="text-2xl font-bold">{year} Season Recap</h1>
        <p class="mt-1 font-mono text-[10px] text-muted-foreground tracking-widest uppercase">
          {completed.length} completed · {correctCount} winners called
        </p>
      </div>
      {yearLinks.length > 1 && <YearSelectLinks items={yearLinks} currentYear={year} />}
    </div>

    {completed.length === 0 ? (
      <div class="border border-white/[0.06] p-10 text-center">
        <p class="font-mono text-[9px] text-muted-foreground tracking-[0.25em] uppercase">No completed predictions for {year}</p>
      </div>
    ) : (
      <>
        <!-- Headline accuracy -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {[
            ['P1 Hit', p1Accuracy === null ? '—' : `${p1Accuracy}%`],
            ['Top 3 Hit', top3Accuracy === null ? '—' : `${top3Accuracy}%`],
            ['Top 5 Hit', top5Accuracy === null ? '—' : `${top5Accuracy}%`],
            ['Brier', brier === null ? '—' : brier.toFixed(3)],
          ].map(([label, value]) => (
            <div class="border border-white/[0.06] p-4">
              <div class="font-mono text-[8px] text-muted-foreground tracking-widest uppercase">{label}</div>
              <div class="text-2xl font-bold text-[#a855f7] mt-1">{value}</div>
            </div>
          ))}
        </div>

        <!-- Highlights -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <div class="panel p-5">
            <div class="flex items-center gap-1.5 font-mono text-[9px] tracking-[0.25em] uppercase mb-3" style="color: rgba(168,85,247,0.55)"><Award size={11} />best call</div>
            {best ? (
              <a href={hrefFor(best)} class="block group">
                <div class="font-bold text-sm group-hover:text-[#a855f7] transition-colors duration-150">{best.raceName}</div>
                <div class="font-mono text-[10px] text-muted-foreground mt-1">
                  Backed <span class="text-foreground">{best.predictedWinner.code}</span> at {Math.round(Number(best.winProbability) * 100)}% — and was right.
                </div>
              </a>
            ) : (
              <p class="font-mono text-[10px] text-muted-foreground">No correct calls yet.</p>
            )}
          </div>

          <div class="panel p-5">
            <div class="flex items-center gap-1.5 font-mono text-[9px] tracking-[0.25em] uppercase mb-3" style="color: rgba(168,85,247,0.55)"><TrendingDown size={11} />worst miss</div>
            {worst ? (
              <a href={hrefFor(worst)} class="block group">
                <div class="font-bold text-sm group-hover:text-[#a855f7] transition-colors duration-150">{worst.raceName}</div>
                <div class="font-mono text-[10px] text-muted-foreground mt-1">
                  Had <span class="text-foreground">{worst.predictedWinner.code}</span> at {Math.round(Number(worst.winProbability) * 100)}%
                  {worst.actualWinner && <> · <span class="text-red-400">{worst.actualWinner.code}</span> won</>}
                  {worst.actualWinnerPredictedPosition !== null && <> from predicted P{worst.actualWinnerPredictedPosition}</>}.
                </div>
              </a>
            ) : (
              <p class="font-mono text-[10px] text-muted-foreground">No misses — every call landed.</p>
            )}
          </div>

          <div class="panel p-5">
            <div class="flex items-center gap-1.5 font-mono text-[9px] tracking-[0.25em] uppercase mb-3" style="color: rgba(168,85,247,0.55)"><Flame size={11} />longest streak</div>
            <div class="text-3xl font-bold text-[#a855f7]">{streak}</div>
            <div class="font-mono text-[10px] text-muted-foreground mt-1">consecutive winners correctly called</div>
          </div>
        </div>

        <!-- Round-by-round strip -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="font-mono text-[9px] tracking-[0.25em] uppercase" style="color: rgba(168,85,247,0.55)">./round by round</span>
            <div class="h-px flex-1 bg-white/[0.05]" />
          </div>
          <div class="flex flex-wrap gap-1.5">
            {ordered.map((h) => (
              <a
                href={hrefFor(h)}
                title={`R${h.roundNumber} ${h.raceName} — predicted ${h.predictedWinner.code}${h.actualWinner ? `, won ${h.actualWinner.code}` : ''}`}
                class={`w-7 h-7 flex items-center justify-center font-mono text-[9px] font-bold border transition-colors duration-150 ${
                  h.correct === true
                    ? 'border-green-500/40 text-green-400 hover:bg-green-500/10'
                    : h.correct === false
                      ? 'border-red-500/40 text-red-400 hover:bg-red-500/10'
                      : 'border-white/[0.08] text-muted-foreground hover:bg-white/[0.04]'
                }`}
              >
                {h.roundNumber}
              </a>
            ))}
          </div>
        </div>
      </>
    )}
  </div>
</BaseLayout>
