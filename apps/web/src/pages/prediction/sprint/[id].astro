---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildPredictionPageData } from '@/features/predictions/buildPredictionPageData';
import PredictionPageBody from '@/features/predictions/components/PredictionPageBody.astro';

const { id } = Astro.params;
const data = await buildPredictionPageData('sprint', Number(id));
---

<BaseLayout title={data.title}>
  <PredictionPageBody data={data} />
</BaseLayout>
