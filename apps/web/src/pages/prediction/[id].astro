---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api } from '@/lib/api';
import type { PredictionResponse, RaceDetailResponse } from '@/types';
import { GP_WEIGHTS, FEATURE_META, contributions } from '@/lib/predictionMath';
import { GP_ACCENT } from '@/features/predictions/types';
import PredictionHeader from '@/features/predictions/components/PredictionHeader.astro';
import PredictionOutcomeBanner from '@/features/predictions/components/PredictionOutcomeBanner.astro';
import ContributionBar from '@/features/predictions/components/ContributionBar.astro';
import PredictionDriverTable from '@/features/predictions/components/PredictionDriverTable.astro';
import DriverRadarCompare from '@/features/predictions/components/DriverRadarCompare.astro';
import ModelWeightsGrid from '@/features/predictions/components/ModelWeightsGrid.astro';
import WhatIfLab from '@/features/predictions/components/WhatIfLab.astro';

const { id } = Astro.params;
const raceId = Number(id);

let prediction: PredictionResponse | null = null;
let raceData: RaceDetailResponse | null = null;
let error: string | null = null;

const [predResult, raceResult] = await Promise.allSettled([
  api.getPredictionByRace(raceId),
  api.getRaceById(raceId),
]);

if (predResult.status === 'fulfilled') prediction = predResult.value;
else error = 'No prediction available for this race';
if (raceResult.status === 'fulfilled') raceData = raceResult.value;

const race = prediction?.race ?? raceData?.race ?? null;
const raceYear = race ? new Date(race.raceDate).getFullYear() : new Date().getFullYear();
const actualWinner = raceData?.results?.find((r) => r.finishPosition === 1) ?? null;
const correct = prediction && actualWinner
  ? prediction.predictedWinner.id === actualWinner.driver.id
  : null;

const winner = prediction
  ? prediction.drivers.find((d) => d.driver.id === prediction!.predictedWinner.id) ?? prediction.drivers[0]
  : null;
const breakdown = winner ? contributions(winner.features, GP_WEIGHTS) : [];

const RADAR_FEATURES: [string, string][] = [
  ['Car Performance', 'carPerformance'],
  ['Long Run Pace', 'longRunPace'],
  ['Tyre Degradation', 'tyreDeg'],
  ['Reliability', 'reliability'],
  ['Quali Delta', 'qualifyingDelta'],
  ['Driver Rating', 'driverRating'],
  ['Win Rate', 'winRate'],
  ['Luck Factor', 'luckFactor'],
  ['Sector Strength', 'sectorStrength'],
  ['Adj. Grid Pos', 'circuitAdjStartPos'],
  ['Adj. Pos Gain', 'circuitAdjPositionGain'],
  ['Weather', 'weatherImpact'],
];
---

<BaseLayout title={race ? `${race.name} Prediction` : 'Race Prediction'}>
  <div class="mt-7 space-y-8">

    <div class="mb-6 flex items-center gap-4">
      <a href="/prediction" class="font-mono text-[9px] tracking-[0.15em] uppercase text-muted-foreground hover:text-foreground transition-colors duration-150">
        ← prediction hub
      </a>
    </div>

    {error && !prediction ? (
      <div class="border border-white/[0.06] p-10 text-center">
        <p class="font-mono text-[9px] text-muted-foreground tracking-[0.25em] uppercase">No prediction for this race</p>
        <p class="mt-2 font-mono text-[8px] text-muted-foreground/50">{error}</p>
      </div>
    ) : prediction && race ? (
      <>
        <PredictionHeader
          title={race.name}
          kicker={`./round-${race.roundNumber.toString().padStart(2, '0')}`}
          city={race.circuit.city}
          country={race.circuit.country}
          date={race.raceDate}
          modelVersion={prediction.modelVersion}
          computedAt={prediction.computedAt}
          p1={Number(prediction.drivers[0]?.winProbability)}
          p2={prediction.drivers[1] ? Number(prediction.drivers[1].winProbability) : null}
          accent={GP_ACCENT}
        />

        {correct !== null && actualWinner && (
          <PredictionOutcomeBanner
            predictedName={prediction.predictedWinner.fullName}
            actualName={actualWinner.driver.fullName}
            actualLabel="actual winner"
            correct={correct}
          />
        )}

        {winner && breakdown.some((b) => b.share > 0) && (
          <ContributionBar driverCode={winner.driver.code} breakdown={breakdown} featureMeta={FEATURE_META} accent={GP_ACCENT} />
        )}

        <div class="grid grid-cols-1 xl:grid-cols-[1fr_400px] gap-8">
          <PredictionDriverTable
            drivers={prediction.drivers}
            results={raceData?.results}
            predictedWinnerId={prediction.predictedWinner.id}
            actualWinnerId={actualWinner?.driver.id}
            raceYear={raceYear}
            accent={GP_ACCENT}
            gridColLabel="Qual Pos"
            actualWinnerLabel="actual winner"
          />

          <div class="space-y-6">
            <DriverRadarCompare drivers={prediction.drivers} features={RADAR_FEATURES} accent={GP_ACCENT} />
            <ModelWeightsGrid heading="./model weights" featureMeta={FEATURE_META} accent={GP_ACCENT} class="hidden xl:block" />
          </div>
        </div>

        <WhatIfLab
          drivers={prediction.drivers}
          featureMeta={FEATURE_META}
          weights={GP_WEIGHTS}
          accent={GP_ACCENT}
          sliderMax={30}
          blurb="Drag the weights to see how the predicted order shifts. Recomputed live in your browser — the model itself is unchanged."
        />

        <ModelWeightsGrid
          heading="./model weights"
          featureMeta={FEATURE_META}
          accent={GP_ACCENT}
          gridClass="grid-cols-2 sm:grid-cols-4"
          class="xl:hidden"
        />
      </>
    ) : null}
  </div>
</BaseLayout>
